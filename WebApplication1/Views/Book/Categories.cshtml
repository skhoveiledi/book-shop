@model dynamic

@{
    ViewBag.Title = "دسته بندی ها";
    Layout = "_Layout";
    var categories = ViewBag.Categories as List<WebApplication1.Models.Domain.Entities.Category>;
}

<div class="row g-4 justify-content-center">
    @if (categories != null && categories.Any())
    {
        @foreach (var c in categories)
        {
            <div class="col-md-2 col-6">
                <div class="book-card">
                    <h6 class="mt-2">@c.Name</h6>
                    
                   
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-center text-muted">هیچ کتابی یافت نشد</p>
        </div>
    }
    
