@using Domain
@model System.Collections.Generic.List<WebApplication1.Models.Domain.Entities.User>

@{
    ViewBag.Title = "مدیریت دسته بندی ها";
    Layout = "_Layout";
}
<style>
    table {
        text-align: center;
    }
</style>
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>مدیریت کاربران</h2>
        <a asp-controller="Category" asp-action="" class="btn btn-success">➕ افزودن دسته بندی جدید</a>
    </div>


    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>شناسه</th>
                <th>نام</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.CreatedAt.ConvertToHijri("yyyy/MM/dd HH:mm")</td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditUser" asp-route-userId="@user.Id" class="btn btn-sm btn-warning">ویرایش</a>
                        <form method="post" asp-action="DeleteUser" asp-route-userId="@user.Id" style="display:inline;"
                              onsubmit="return confirm('آیا مطمئن هستید؟');">
                            <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    <div class="mt-4">
        <a href="/Admin/Index" class="btn btn-secondary">بازگشت به پنل مدیریت</a>
    </div>
</div>
