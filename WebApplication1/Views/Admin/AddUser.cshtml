@model WebApplication1.Models.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Add New User";
}

<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn/Vazirmatn-font-face.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
<style>
    body {
        font-family: 'Vazirmatn', sans-serif;
        direction: rtl;
        background-color: #f5f8fc;
    }

    .form-container {
        max-width: 500px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
</style>

<div class="form-container">
    <h2 class="text-center mb-4">افزودن کاربر جدید</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-danger">
            @Model.Message
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" value="0" />

        <div class="mb-3">
            <label class="form-label">نام</label>
            <input type="text" asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">ایمیل</label>
            <input type="email" asp-for="Email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">رمز عبور</label>
            <input type="password" asp-for="Password" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">نقش کاربری</label>
            <select asp-for="Role" class="form-select" required>
                <option value="">-- انتخاب نقش --</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@((int)role)">@role</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">ذخیره</button>
        <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary w-100">انصراف</a>
    </form>
</div>