@model WebApplication1.Models.ViewModels.UserViewModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="form-container">
    <h2 class="text-center mb-4">ویرایش کاربر</h2>
    @if (Model.Message is not null)
    {
        <div class="alert alert-danger">
            @Model.Message
        </div>
    }
    <form method="post" asp-controller="Admin" asp-action="EditUser">
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3">
            <label class="form-label">نام</label>
            <input type="text" asp-for="Name" class="form-control" required/>
        </div>
        <div class="mb-3">
            <label class="form-label">ایمیل</label>
            <input type="text" asp-for="Email" class="form-control" required/>
        </div>
        <div>
            <label class="form-label">پسورد</label>
            <input type="password" asp-for="Password" class="form-control" required/>
        </div>
        <div class="mb-3">
            <label class="form-label">نقش کاربری</label>
            <select asp-for="Role" class="form-select" required>
                @foreach (var role in Model.Roles)
                {
                    <option value="@((int)role)" selected="@(Model.Role==role)">@role</option>
                }
            </select>
        </div>
        <button type="submit">ذخیره</button>
        <button><a asp-controller="Admin" asp-action="Users">انصراف</a></button>
    </form>
</div>


