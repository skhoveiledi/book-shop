@{
    ViewData["Title"] = "Admin Panel";
}

<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn/Vazirmatn-font-face.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
<style>
    body {
        font-family: 'Vazirmatn', sans-serif;
        direction: rtl;
        background-color: #f5f8fc;
    }

    .admin-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.2s;
        text-align: center;
    }

        .admin-card:hover {
            transform: translateY(-4px);
        }
</style>

<div class="container my-5">
    <h1 class="text-center mb-5">پنل مدیریت</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="admin-card">
                <h3>👥 مدیریت کاربران</h3>
                <p>ثبت، نمایش، ویرایش و حذف کاربران</p>
                <a href="/Admin/Users" class="btn btn-primary">مدیریت کاربران</a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="admin-card">
                <h3>📚 مدیریت دسته‌بندی‌ها</h3>
                <p>ثبت، نمایش، ویرایش و حذف دسته‌بندی‌ها</p>
                <a href="/Admin/Categories" class="btn btn-success">مدیریت دسته‌بندی‌ها</a>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/Home/Index" class="btn btn-secondary">بازگشت به صفحه اصلی</a>
    </div>
</div>